# ===== Local / development =====
NODE_ENV=development
PORT=3000
POSTGRES_DB=bicar_parts
POSTGRES_USER=bicar
POSTGRES_PASSWORD=bicar_local_dev
DATABASE_URL=postgres://bicar:bicar_local_dev@db:5432/bicar_parts
JWT_SECRET=LOCAL_DEV_ONLY_CHANGE_BEFORE_PRODUCTION_123456789
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Власник BI-CAR PARTS
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=/app/uploads

# ===== AutoPartsAPI / APIProfile =====
AUTOPARTSAPI_ENABLED=false
AUTOPARTSAPI_BASE_URL=https://auto-parts-catalog.apiprofile.com
AUTOPARTSAPI_KEY=
AUTOPARTSAPI_TYPE_ID=1
AUTOPARTSAPI_LANG_ID=4
AUTOPARTSAPI_TIMEOUT_MS=15000

# ===== Telegram =====
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Email =====
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bicarparts2026@gmail.com
SMTP_PASS=
NOTIFY_EMAIL_FROM=BI-CAR PARTS <bicarparts2026@gmail.com>
NOTIFY_EMAIL_TO=bicarparts2026@gmail.com

# ===== Web Push =====
WEBPUSH_ENABLED=false
VAPID_SUBJECT=mailto:bicarparts2026@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Онлайн-чат =====
CHAT_MAX_FILE_MB=10
CHAT_OFFLINE_MESSAGE=Дякуємо за повідомлення! Зараз менеджер офлайн. Ми відповімо вам найближчим часом.
